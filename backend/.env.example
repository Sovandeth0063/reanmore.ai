# =============================================================================
# ReanMore - Elementary STEM Socratic Tutor Environment Configuration
# =============================================================================

# Primary LLM Provider (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_REASONING_MODEL=gemini-2.0-flash-thinking
GEMINI_VISION_MODEL=gemini-2.0-flash

# Optional Providers
OPENAI_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=ollama

# Local Ollama Fallback (reanmore-ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FAST_MODEL=qwen3.5:4b
OLLAMA_REASONING_MODEL=gemma4:e4b

# Service Ports (9000 Series)
ORCHESTRATOR_PORT=9000
MATH_SERVICE_PORT=9001
SCIENCE_SERVICE_PORT=9002

# Internal Service URLs (Resolved within Docker network)
MATH_SERVICE_URL=http://math-service:9001
SCIENCE_SERVICE_URL=http://science-service:9002

# Stateful Cache (Redis Stack) & Vector DB (Qdrant)
REDIS_URL=redis://redis:6379/0
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# PostgreSQL Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=science_chatbot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/science_chatbot

# MinIO File Vault Storage (Textbooks & Student Scans)
# External API port: 9100, Console: 9101 (avoids port 9000 clash with orchestrator)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_SCANS=student-scans
MINIO_SECURE=false

# Authentication & Student Security (Class Code + 4-digit PIN)
AUTH_SECRET_KEY=reanmore_insecure_default_secret_key_change_in_prod
AUTH_TOKEN_EXPIRE_DAYS=30

# Problem Quota System (10 problems/day, 300 problems/month, Asia/Phnom_Penh reset)
QUOTA_DAILY=10
QUOTA_MONTHLY=300
QUOTA_TZ=Asia/Phnom_Penh

# Safeguarding Escalation Dispatch
SAFEGUARDING_WEBHOOK_URL=
SAFEGUARDING_ALERT_EMAIL=
SAFEGUARDING_DISPATCH_TIMEOUT_SEC=3.0
