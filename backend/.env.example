# =============================================================================
# ReanMore v2.1 — Streamlined 4-Container MVP
# Stack: orchestrator (FastAPI), db (PostgreSQL 16), ollama (local model), frontend
# =============================================================================

# --- LLM (local resident Ollama; $0 cloud inference) ---
# Inside Docker, docker-compose.yml overrides this with host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FAST_MODEL=qwen3.5:4b
OLLAMA_REASONING_MODEL=qwen3.5:4b
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=mock
LLM_MAX_INFLIGHT=1

# Optional cloud providers (leave blank for the offline MVP)
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Gateway ---
ORCHESTRATOR_PORT=9000

# --- PostgreSQL 16 (system of record) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=science_chatbot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/science_chatbot

# --- Authentication & Student Security (Class Code + 4-digit PIN) ---
AUTH_SECRET_KEY=reanmore_insecure_default_secret_key_change_in_prod
AUTH_TOKEN_EXPIRE_DAYS=30

# --- Problem Quota (Asia/Phnom_Penh, UTC+7) ---
QUOTA_DAILY=10
QUOTA_MONTHLY=300
QUOTA_TZ=Asia/Phnom_Penh

# --- Safeguarding Escalation Dispatch ---
SAFEGUARDING_WEBHOOK_URL=
SAFEGUARDING_ALERT_EMAIL=
SAFEGUARDING_DISPATCH_TIMEOUT_SEC=3.0

# --- Feature flags ---
# Khmer UI toggle + dynamic /api/translate (full NLP is deferred to v2.2)
ENABLE_KHMER_LANGUAGE=true
# Worksheet photo OCR is deferred to Phase 4; /api/upload/* returns 404 while false
ENABLE_API_OCR=false
ENABLE_VOICE_STT=false
