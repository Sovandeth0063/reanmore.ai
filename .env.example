# ReanMore v2.1 — Streamlined 4-Container MVP
# Stack: orchestrator (FastAPI), db (PostgreSQL 16), ollama (local model), frontend (Nginx)
# Copy to .env and adjust for your workstation.

# Local resident model (host Ollama by default; the container profile overrides this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=mock
LLM_MAX_INFLIGHT=1

# Gateway
ORCHESTRATOR_PORT=9000

# PostgreSQL 16 (system of record: profiles, sessions, quota ledger, gap events)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=science_chatbot
# Inside Docker the host is `db`; for local runs use localhost:5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/science_chatbot

# Quota (Asia/Phnom_Penh, UTC+7)
QUOTA_DAILY=10
QUOTA_MONTHLY=300
QUOTA_TZ=Asia/Phnom_Penh

# Auth
AUTH_SECRET_KEY=change-this-insecure-default-before-deploying

# Phase 4 / v2.2 feature flags — OFF in the MVP
# Worksheet photo OCR (deferred; /api/upload returns 404 while false)
ENABLE_API_OCR=false
# Khmer UI toggle + dynamic /api/translate (full NLP/segmentation deferred to v2.2)
ENABLE_KHMER_LANGUAGE=true
ENABLE_VOICE_STT=false
